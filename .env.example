# Alpaca API credentials
# Get your keys at https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Use "paper" for paper trading, "live" for real trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Cache settings
CACHE_DIR=.cache
CACHE_TTL_MINUTES=15

# Polygon.io (Options Flow Scanner - free tier)
POLYGON_API_KEY=your_polygon_key_here

# Financial Modeling Prep (Earnings Whisper - free tier)
FMP_API_KEY=your_fmp_key_here

# Upstash Redis (persistent config storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth (change in production!)
JWT_SECRET=your-secret-key-here
JWT_EXPIRY_HOURS=72

# Telegram alerts (bot from @BotFather; chat id from the bot's getUpdates).
# Keep the token here or in the host's environment, never in the web page's
# saved settings, which are publicly readable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keep-alive for hosts that sleep when idle (Render free plan). On Render the
# address is detected automatically; locally it stays off unless set.
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URL=
# KEEP_ALIVE_START_ET=04:00
# KEEP_ALIVE_END_ET=16:15
# KEEP_ALIVE_INTERVAL_SECONDS=300

# Pre-load the Stock Screener's Yahoo Finance data at startup and each cycle.
# Off by default: it held about 110 MB on the 512 MB host.
# PROFILE_WARMUP_ENABLED=false
